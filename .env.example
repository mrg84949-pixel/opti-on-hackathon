# =============================================================================
# Backend — LOCAL DEV (.env)
# =============================================================================
# Скопировать:  cp .env.example .env
#
# В проекте несколько env-файлов (это нормально — разные процессы):
#   .env                          — backend (этот шаблон → корневой .env)
#   frontend-bot/.env             — Next.js BFF (см. frontend-bot/.env.example)
#   .env.prod.example             — УРЕЗАННЫЙ шаблон для VPS + docker-compose.prod.yml
#   frontend-bot/.env.prod.example — vars фронта в prod (значения кладут в root .env)
#
# .env.prod.example появился в PR.3 (pilot deploy): там только то, что нужно compose на
# сервере. Полный справочник всех переменных — этот файл и bot/config.py (Settings).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database (обязательно)
# -----------------------------------------------------------------------------
# Локально: docker compose up -d  →  postgres на localhost:5432
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/bot_saas

# -----------------------------------------------------------------------------
# 2. Auth (обязательно для регистрации / JWT)
# -----------------------------------------------------------------------------
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
USER_AUTH_SECRET=change-me-dev-only

# Токены админ-панели (backend API + вход в /login)
# ADMIN_API_TOKEN=
# ADMIN_UI_TOKEN=

# -----------------------------------------------------------------------------
# 3. AI / LLM
# -----------------------------------------------------------------------------
# Провайдер: gemini (prod default) | groq (dev) | stub
AI_PROVIDER=gemini

# Режим без live LLM: 1 / true — ответ из AI_STUB_MESSAGE (CI, инцидент)
# AI_USE_STUB=0
# AI_STUB_MESSAGE=Заглушка: ответ без вызова Gemini.

# Google Gemini (prod)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq — dev/testing (OpenAI-compatible API, tool calling)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------------------------------------------------------
# 4. Booking UX (deterministic paths, без LLM)
# -----------------------------------------------------------------------------
# AI_BOOKING_SHORTCUTS=1   # default on: confirm «да/нет», каталог «прайс»
# AI_BOOKING_FSM=1         # default off: линейный FSM name→service→…→confirm

# -----------------------------------------------------------------------------
# 5. Organization / tenant
# -----------------------------------------------------------------------------
# ID организации из таблицы organizations (после seed обычно 1)
DEFAULT_ORG_ID=1

# Prod: 1 — tenant secrets только в organizations.* (без env fallback для CRM/WA/TG).
# Блокирует: CRM_STAFF_JSON, AMOCRM_*, GREEN_API_*, WHATSAPP_GRAPH_*, TELEGRAM_TOKEN (outbound).
# TENANT_CONFIG_STRICT=0

# Fernet master key для шифрования secrets в БД (prod, SG-15).
# Dev: leave empty + STRICT_STARTUP_VALIDATION=0 (section 13). Invalid key + strict=1 → startup fail.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Preflight: python scripts/validate_fernet_key.py --require --env-file .env.prod.local
# TENANT_SECRETS_MASTER_KEY=

# Оплата тарифа: organizations.billing_paid_until (UTC). Прошлая дата → бот не отвечает.

# -----------------------------------------------------------------------------
# 6. Public URLs
# -----------------------------------------------------------------------------
# Ссылки в письмах (сброс пароля) и webhook-документация
# PUBLIC_APP_URL=http://localhost:3000
# BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 7. Telegram
# -----------------------------------------------------------------------------
# Канальные токены org — в БД (/bot/channels). Env — fallback для dev/single-tenant.
# TELEGRAM_TOKEN=
# TELEGRAM_WEBHOOK_URL=https://your-domain/bot/webhook
# # Hoster blocks Telegram inbound: Cloudflare Tunnel + https://tg.your-domain/bot/webhook
# # (see docker-compose.prod.yml profile cloudflare / CLOUDFLARE_TUNNEL_TOKEN)
# # Legacy alt port: https://your-domain:8443/bot/webhook
# CLOUDFLARE_TUNNEL_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# ADMIN_TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# 8. WhatsApp
# -----------------------------------------------------------------------------
# WHATSAPP_PROVIDER=green

# Green-API (legacy / dev)
# GREEN_API_INSTANCE_ID=
# GREEN_API_TOKEN=

# Meta WhatsApp Cloud API (production)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_ACCESS_TOKEN=
# WHATSAPP_GRAPH_API_VERSION=v21.0
# WHATSAPP_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# 9. SMTP / contact form
# -----------------------------------------------------------------------------
# CONTACT_FORM_TO_EMAIL=hello@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=1

# -----------------------------------------------------------------------------
# 10. CRM (multi-tenant)
# -----------------------------------------------------------------------------
# В релизе secrets CRM — в organizations.crm_* (БД), не в общем .env.
# CRM_PROVIDER=amocrm
# CRM_ENV_FALLBACK_ENABLED=0
# AMOCRM_BASE_URL=https://your-subdomain.amocrm.ru
# AMOCRM_TOKEN=

# -----------------------------------------------------------------------------
# 11. Google OAuth (опционально)
# -----------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_REDIRECT_URI=

# -----------------------------------------------------------------------------
# 12. Reminders & background jobs
# -----------------------------------------------------------------------------
# REMINDER_JOB_INTERVAL_MINUTES=60
# REMINDER_WINDOW_MINUTES=60
# REMINDER_FAIR_MAX_PER_ORG_PER_TICK=100
# CRM_SYNC_INTERVAL_MINUTES=15
# CLIENT_CHANGE_RESPONSE_HOURS=24
# STRESS_TG_USER=900000001

# -----------------------------------------------------------------------------
# 13. Ops / logging / rate limits
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LLM_DEBUG_TRACE=0
# Dev default: 0 — allows empty/invalid TENANT_SECRETS_MASTER_KEY for local uvicorn.
# Prod / local prod stack: 1 — requires valid Fernet key (see validate_fernet_key.py).
# STRICT_STARTUP_VALIDATION=0
# SKIP_METADATA_CREATE_ALL=0

# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_AUTH_IP_LIMIT=30
# RATE_LIMIT_AUTH_EMAIL_LIMIT=10
# RATE_LIMIT_WEBHOOK_IP_LIMIT=600
# RATE_LIMIT_CONTACT_IP_LIMIT=10

# -----------------------------------------------------------------------------
# 14. Production (VPS)
# -----------------------------------------------------------------------------
# На сервере: cp .env.prod.example .env  +  docker compose -f docker-compose.prod.yml up -d
# См. docs/dev-runbook.md § PR.3 / mvp-launch-checklist.md
# Prod compose задаёт TENANT_CONFIG_STRICT, STRICT_STARTUP_VALIDATION, SKIP_METADATA_CREATE_ALL.

# Twilio Voice (hackathon call module)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Redis (hackathon: call-state/queueing — local Memurai instance)
REDIS_URL=redis://127.0.0.1:6379/0
